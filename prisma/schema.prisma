generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model User {
  id_user       String   @id @default(cuid())
  username      String   
  email         String   @unique
  password      String?
  role          String   @default("USER") 
}

model Kampus {
  id_kampus     String   @id @default(cuid())
  nama_kampus   String
  alamat_kampus String
  tempat        Tempat[]
}

model Fasilitas {
  id_fasilitas   String            @id @default(cuid())
  nama_fasilitas String
  tempat         TempatFasilitas[]
}

model Kategori {
  id_kategori   String           @id @default(cuid())
  nama_kategori String
  tempat        TempatKategori[]
}

model Tempat {
  id_tempat     String            @id @default(cuid())
  id_kampus     String
  nama_tempat   String
  alamat        String
  jam_buka      String
  kisaran_harga String
  kampus        Kampus            @relation(fields: [id_kampus], references: [id_kampus])
  fasilitas     TempatFasilitas[]
  kategori      TempatKategori[]
}

model TempatFasilitas {
  id_tempat    String
  id_fasilitas String
  tempat       Tempat    @relation(fields: [id_tempat], references: [id_tempat])
  fasilitas    Fasilitas @relation(fields: [id_fasilitas], references: [id_fasilitas])

  @@id([id_tempat, id_fasilitas])
}

model TempatKategori {
  id_tempat   String
  id_kategori String
  tempat      Tempat   @relation(fields: [id_tempat], references: [id_tempat])
  kategori    Kategori @relation(fields: [id_kategori], references: [id_kategori])

  @@id([id_tempat, id_kategori])
}