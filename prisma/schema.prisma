generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String  @id @default(cuid())
  username    String
  email       String  @unique
  password    String?
  role        String  @default("USER")
  no_telp     String?
  google_id   String? @unique
  foto_profil String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorit Favorit[]
}

model Kampus {
  id_kampus     String   @id
  nama_kampus   String
  alamat_kampus String
  tempat        Tempat[]
  places        Place[]
}

model Kategori {
  id_kategori   String           @id
  nama_kategori String
  tempat        TempatKategori[]
}

model Fasilitas {
  id_fasilitas   String            @id
  nama_fasilitas String
  tempat         TempatFasilitas[]
}

model Tempat {
  id_tempat       String           @id @default(cuid())
  nama_tempat     String
  alamat          String
  jam_buka        String
  kisaran_harga   String
  jumlah_meja     Int?             // Ditambahkan (bersifat opsional, tipe data angka)
  jumlah_lantai   Int?             // Ditambahkan (bersifat opsional, tipe data angka)
  id_kampus       String

  kampus        Kampus           @relation(fields: [id_kampus], references: [id_kampus])
  fasilitas     TempatFasilitas[]
  kategori      TempatKategori[]
  favorit       Favorit[]
  places        Place[]
  booking       Booking[]
}

model TempatKategori {
  id_tempat   String
  id_kategori String
  tempat      Tempat   @relation(fields: [id_tempat], references: [id_tempat], onDelete: Cascade)
  kategori    Kategori @relation(fields: [id_kategori], references: [id_kategori], onDelete: Cascade)

  @@id([id_tempat, id_kategori])
}

model TempatFasilitas {
  id_tempat    String
  id_fasilitas String
  tempat       Tempat    @relation(fields: [id_tempat], references: [id_tempat], onDelete: Cascade)
  fasilitas    Fasilitas @relation(fields: [id_fasilitas], references: [id_fasilitas], onDelete: Cascade)

  @@id([id_tempat, id_fasilitas])
}

model Favorit {
  id        String   @id @default(cuid())
  userId    String
  tempatId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tempat Tempat @relation(fields: [tempatId], references: [id_tempat], onDelete: Cascade)

  @@unique([userId, tempatId])
}

model Place {
  id      String  @id @default(cuid())
  name    String
  rating  Float   @default(0.0)
  review  String? // Untuk ulasan teks
  voucher String? // Untuk kode atau deskripsi voucher

  id_kampus String?
  kampus    Kampus? @relation(fields: [id_kampus], references: [id_kampus])
  tempatId  String
  tempat    Tempat @relation(fields: [tempatId], references: [id_tempat])
}

model Booking {
  id        String   @id @default(cuid())
  tempatId  String
  status    String   @default("pending")  // ← tambahkan ini
  nama      String
  tanggal   DateTime
  jam       String
  nomor     String
  createdAt DateTime @default(now())

  tempat    Tempat   @relation(fields: [tempatId], references: [id_tempat])
}