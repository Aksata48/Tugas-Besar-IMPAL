generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id          String  @id @default(cuid())
  username    String
  email       String  @unique
  password    String?
  role        String  @default("USER")
  no_telp     String?
  google_id   String? @unique
  foto_profil String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorit Favorit[]
  booking Booking[]
}

model Kampus {
  id_kampus     String   @id
  nama_kampus   String
  alamat_kampus String
  latitude       Float //jarakterdekat
  longitude      Float //jarakterdekat
  tempat        Tempat[]
  places        Place[]
}

model Kategori {
  id_kategori   String           @id
  nama_kategori String
  tempat        TempatKategori[]
}

model Fasilitas {
  id_fasilitas   String            @id
  nama_fasilitas String
  tempat         TempatFasilitas[]
}

model Tempat {
  id_tempat     String   @id
  nama_tempat   String
  alamat        String
  //buat map
  gambar String?
  
  // Geolocation
  latitude      Float    @default(-6.9175) 
  longitude     Float    @default(107.6191)
  
  // Kolom baru untuk logika status operasional real-time
  waktu_buka    String   // Format "HH:mm" (Contoh: "08:00")
  waktu_tutup   String   // Format "HH:mm" (Contoh: "23:00")
  
  // Kolom opsional untuk tampilan teks di UI
  jam_buka      String?  // Contoh: "08:00 - 23:00" atau "24 Jam"
  
  kisaran_harga String   //
  id_kampus     String   //
  jumlah_meja   Int?
  jumlah_lantai Int?

  // Kolom menu & foto tempat (upload file)
  menu_text   String?  // Deskripsi teks menu andalan (opsional)
  menu_gambar String?  // Path file foto menu, contoh: "/uploads/menu-xxx.jpg"

  // Relasi ke model lain
  kampus    Kampus            @relation(fields: [id_kampus], references: [id_kampus]) //
  fasilitas TempatFasilitas[] //
  kategori  TempatKategori[]  //
  favorit   Favorit[]         //
  places    Place[]           //

  booking   Booking[]
  mejas     Meja[]
}

// =============================================
// Model baru: Meja (relasi ke Tempat)
// =============================================
model Meja {
  id              String  @id @default(cuid())
  nomor_meja      String  // Contoh: "Meja 01"
  nama_lantai     String  // Contoh: "Lantai 1"
  tipe_lantai     String? @default("INDOOR") // INDOOR / OUTDOOR
  kapasitas_kursi Int     // Contoh: 4
  x               Float?  @default(0) // Koordinat X (%) untuk layout visual
  y               Float?  @default(0) // Koordinat Y (%) untuk layout visual

  tempatId  String
  tempat    Tempat    @relation(fields: [tempatId], references: [id_tempat], onDelete: Cascade)
  bookings  Booking[]
}

model TempatKategori {
  id_tempat   String
  id_kategori String
  tempat      Tempat   @relation(fields: [id_tempat], references: [id_tempat], onDelete: Cascade)
  kategori    Kategori @relation(fields: [id_kategori], references: [id_kategori], onDelete: Cascade)

  @@id([id_tempat, id_kategori])
}

model TempatFasilitas {
  id_tempat    String
  id_fasilitas String
  tempat       Tempat    @relation(fields: [id_tempat], references: [id_tempat], onDelete: Cascade)
  fasilitas    Fasilitas @relation(fields: [id_fasilitas], references: [id_fasilitas], onDelete: Cascade)

  @@id([id_tempat, id_fasilitas])
}

model Favorit {
  id        String   @id @default(cuid())
  userId    String
  tempatId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tempat Tempat @relation(fields: [tempatId], references: [id_tempat], onDelete: Cascade)

  @@unique([userId, tempatId])
}

model Place {
  id      String  @id @default(cuid())
  name    String
  rating  Float   @default(0.0)
  review  String? // Untuk ulasan teks
  voucher String? // Untuk kode atau deskripsi voucher

  id_kampus String?
  kampus    Kampus? @relation(fields: [id_kampus], references: [id_kampus])
  tempatId  String
  tempat    Tempat @relation(fields: [tempatId], references: [id_tempat])
}

model Booking {
  id        String   @id @default(cuid())
  tanggal   DateTime
  jam       String
  nama      String
  nomor     String
  catatan   String?
  lantai     String?
  nomorMeja  String?
  status    String   @default("pending")

  // Kolom baru: relasi ke Meja & jam mulai/selesai untuk anti-overlap
  mejaId      String?
  meja        Meja?   @relation(fields: [mejaId], references: [id], onDelete: SetNull)
  jam_mulai   String? // Format "HH:mm", contoh: "10:00"
  jam_selesai String? // Format "HH:mm", contoh: "12:00"

  // Kolom baru untuk pembayaran DP via Midtrans QRIS
  total_harga  Float?  @default(0)
  dp_harga     Float?  @default(0)
  midtrans_id  String? // Transaction ID dari Midtrans
  midtrans_qr  String? // URL gambar QR code dari Midtrans

  // relasi ke tempat
  tempatId  String
  tempat    Tempat  @relation(fields: [tempatId], references: [id_tempat], onDelete: Cascade)

  // opsional relasi ke user (kalau login)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}